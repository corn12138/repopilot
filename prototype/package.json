{
  "name": "repopilot-prototype",
  "version": "0.0.1",
  "private": true,
  "description": "RepoPilot 产品种子 — Electron + React Agent Workbench",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "selftest": "electron-vite build && REPOPILOT_SELFTEST=1 electron .",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64 --config electron-builder.yml",
    "eval:spk010": "vite build --config eval.vite.config.ts && node eval-out/.build/run-experiment.js",
    "probe:journals": "REPOPILOT_PROBE_JOURNALS=${REPOPILOT_PROBE_JOURNALS:-1} vitest run src/main/observer/journalShape.probe.test.ts",
    "probe:desktop": "REPOPILOT_PROBE_DESKTOP=${REPOPILOT_PROBE_DESKTOP:-1} vitest run src/main/observer/desktopProbe.probe.test.ts",
    "probe:workbench": "REPOPILOT_PROBE_WORKBENCH=${REPOPILOT_PROBE_WORKBENCH:-1} vitest run src/main/workbench/codexAdapter.probe.test.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.260",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  }
}
